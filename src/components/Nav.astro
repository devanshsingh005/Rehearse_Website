---
import { Image } from 'astro:assets';
import Menu from '@lucide/astro/icons/menu';
import X from '@lucide/astro/icons/x';
import icon from '../assets/icon.png';
import AppStoreBadge from './AppStoreBadge.astro';
import { NAV_LINKS, SITE } from '../data/site';

interface Props {
  active?: string;
}

const { active } = Astro.props;
---

<header class="nav">
  <div class="nav__inner container">
    <a class="brand" href="/">
      <Image src={icon} alt="" width={30} height={30} densities={[1, 2, 3]} loading="eager" class="brand__icon" />
      <span>Re-Hearse</span>
    </a>

    <nav class="nav__links" aria-label="Main">
      {
        NAV_LINKS.map((link) => (
          <a href={link.href} aria-current={'key' in link && link.key === active ? 'page' : undefined}>
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="nav__actions">
      <a class="btn btn--primary btn--sm" href={SITE.appStoreUrl}>Download</a>
      <button class="nav__menu-btn" type="button" popovertarget="mobile-menu" aria-label="Open menu">
        <Menu size={22} stroke-width={1.75} aria-hidden="true" />
      </button>
    </div>
  </div>
</header>

<div id="mobile-menu" class="menu" popover>
  <div class="menu__top">
    <span class="menu__title">Menu</span>
    <button class="menu__close" type="button" popovertarget="mobile-menu" popovertargetaction="hide" aria-label="Close menu">
      <X size={22} stroke-width={1.75} aria-hidden="true" />
    </button>
  </div>
  <nav aria-label="Mobile">
    <ul role="list" class="menu__list">
      {
        NAV_LINKS.map((link) => (
          <li>
            <a href={link.href} aria-current={'key' in link && link.key === active ? 'page' : undefined}>
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <AppStoreBadge height={48} class="menu__badge" />
</div>

<script>
  // Popovers don't close by themselves when one of their links is followed.
  const menu = document.getElementById('mobile-menu');
  menu?.addEventListener('click', (event) => {
    if ((event.target as Element).closest('a')) menu.hidePopover();
  });
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--nav-h);
  }

  /* The bar fades in once you start scrolling. */
  .nav::before {
    content: '';
    position: absolute;
    inset: 0;
    background: rgb(17 15 13 / 0.78);
    -webkit-backdrop-filter: saturate(160%) blur(18px);
    backdrop-filter: saturate(160%) blur(18px);
    border-bottom: 1px solid var(--line);
  }

  @supports (animation-timeline: scroll()) {
    .nav::before {
      animation: nav-fade linear both;
      animation-timeline: scroll(root);
      animation-range: 0 72px;
    }
  }

  @keyframes nav-fade {
    from {
      opacity: 0;
    }
  }

  .nav__inner {
    position: relative;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    white-space: nowrap;
    font-weight: 650;
    font-size: 1.0625rem;
    letter-spacing: -0.02em;
  }

  .brand__icon {
    width: 30px;
    height: 30px;
    border-radius: 8px;
  }

  .nav__links {
    display: flex;
    gap: 4px;
  }

  .nav__links a {
    padding: 8px 14px;
    border-radius: 999px;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--text-2);
    transition: color 0.2s, background-color 0.2s;
  }

  .nav__links a:hover,
  .nav__links a[aria-current='page'] {
    color: var(--text);
    background: rgb(255 255 255 / 0.06);
  }

  .nav__actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .nav__menu-btn,
  .menu__close {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 999px;
    color: var(--text);
    -webkit-tap-highlight-color: transparent;
  }

  .nav__menu-btn:hover,
  .menu__close:hover {
    background: rgb(255 255 255 / 0.07);
  }

  .nav__menu-btn {
    display: none;
  }

  @media (max-width: 860px) {
    .nav__links {
      display: none;
    }

    .nav__menu-btn {
      display: grid;
    }
  }

  @media (max-width: 360px) {
    .nav__inner {
      gap: 12px;
    }

    .brand {
      gap: 8px;
    }

    .nav__actions :global(.btn--sm) {
      padding: 0 13px;
    }
  }

  /* ---------- Mobile menu (native popover: Esc and outside taps close it) ---------- */
  .menu {
    inset: 8px 8px auto auto;
    width: min(360px, calc(100vw - 16px));
    margin: 0;
    padding: 12px 12px 20px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-lg);
    background: #1c1916;
    color: var(--text);
    box-shadow: 0 30px 80px -20px rgb(0 0 0 / 0.8);
    opacity: 0;
    transform: translateY(-8px) scale(0.98);
    transform-origin: top right;
    transition:
      opacity 0.2s,
      transform 0.25s var(--ease-out),
      overlay 0.25s allow-discrete,
      display 0.25s allow-discrete;
  }

  .menu:popover-open {
    opacity: 1;
    transform: none;
  }

  @starting-style {
    .menu:popover-open {
      opacity: 0;
      transform: translateY(-8px) scale(0.98);
    }
  }

  .menu::backdrop {
    background: rgb(0 0 0 / 0.45);
  }

  .menu__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 0 6px 12px;
  }

  .menu__title {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-3);
  }

  .menu__list a {
    display: block;
    padding: 12px;
    border-radius: 14px;
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .menu__list a:hover,
  .menu__list a[aria-current='page'] {
    background: rgb(255 255 255 / 0.06);
  }

  .menu :global(.menu__badge) {
    margin: 16px 0 0 12px;
  }
</style>
